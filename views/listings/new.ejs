<% layout('layouts/boilerplate') -%>

    <body>
        <div class="row">
            <div class="col-8 offset-2">
                <h3>Create a new listing</h3>
                <form method="POST" action="/listings" novalidate class="needs-validation">
                    <div class="mb-3">
                        <label for="title" class="form-label">Title</label>
                        <input 
                            id="title"
                            name="listing[title]" 
                            placeholder="Enter the perfect headline" 
                            type="text"
                            class="form-control"
                            required
                        />
                        <div class="valid-feedback">Perfection</div>  
                        <div class="invalid-feedback">Please enter a title.</div>  
                    </div>
                    

                    
                    <div class="mb-3">
                        <textarea
                            name="listing[description]"
                            class="form-control"
                            placeholder="Hit the slopes in style with this luxurious ski chalet in the world-famous Aspen ski resort."
                            required
                        ></textarea>
                        <div class="valid-feedback">Aptly described it.</div>  
                        <div class="invalid-feedback">Please write something about it.</div> 
                    </div>
                    
                    <div class="mb-3">
                        <label for="image" class="form-label">Image Link</label>
                        <input 
                            id="image"
                            name="listing[image][url]" 
                            placeholder="enter image URL/Link" 
                            type="text" 
                            class="form-control"
                        />
                        <div class="valid-feedback">Looks beautiful.</div>
                        <div class="invalid-feedback">Can't see your amazing property!</div>
                    </div>

                    <div class="mb-3">
                        <label for="price" class="form-label">Price </label>
                        <input 
                            id="price" 
                            name="listing[price]" 
                            placeholder="&#8377;20,000" 
                            type="number"
                            class="form-control"
                            required
                        >
                        <div class="valid-feedback">Absolutely worth it.</div>
                        <div class="invalid-feedback">How much? </div>
                    </div>
                    
                    <div class="row">
                        <div class="mb-3 col-md-6">
                        <label for="location" class="form-label">Location</label>
                        <input 
                            id="location" 
                            name="listing[location]" 
                            placeholder="London" 
                            type="text"
                            class="form-control"
                            required
                        >
                        <div class="valid-feedback">Lovely Spot. </div>
                        <div class="invalid-feedback">Please disclose the Location.</div>
                    </div>
                    
                    
                    <div class="mb-3 col-md-6">
                        <label for="country" class="form-label">Country</label>
                        <input 
                            id="country" 
                            name="listing[country]" 
                            placeholder="United Kingdom" 
                            type="text"
                            class="form-control"
                            required
                        >
                        <div class="valid-feedback">Sounds Good.</div>
                        <div class="invalid-feedback">Which country is it?</div>
                    </div>
                    </div>
                    
                    
                
                    

                    
                    <button btn btn-dark>Add</button>

                </form>
            </div>
        </div>
    </body>
