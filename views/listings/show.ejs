<% layout('layouts/boilerplate') -%>
<body>
    <div class="row mt-3">
        <div class="col-8 offset-2">
            <h3 class="mb-3"><%= listing.title %></h3>
            
            <div class="card show-card">
                <!-- Custom responsive show-img class handles framing -->
                <% const imgSrc = (listing && listing.image && listing.image.url) ? listing.image.url : (typeof listing.image === 'string' ? listing.image : ''); %>
                <img src="<%= imgSrc %>" class="card-img-top show-img" alt="listing_image">
                
                <div class="card-body px-0">
                    <p class="card-text mt-2 mb-1 text-muted">
                        <i>Owned by Anonymous</i> <!-- Optional placeholder tag -->
                    </p>
                    
                    <p class="card-text description-text mb-3">
                        <%= listing.description %>
                    </p>
                    
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <p class="card-text price-text mb-1">
                                <b>₹<%= listing.price.toLocaleString("en-IN") %></b> / night
                            </p>
                            <p class="card-text location-text text-muted mb-0">
                                <i class="fa-solid fa-location-dot me-2"></i><%= listing.location %>, <%= listing.country %>
                            </p>
                        </div>

                        <div class="d-flex gap-2 align-items-start">
                            <a href="/listings/<%=listing._id%>/edit" class="btn btn-dark btn-sm">Edit</a>
                            <form method="POST" action="/listings/<%=listing._id%>?_method=DELETE" class="d-inline">
                                <button class="btn btn-outline-danger btn-sm">Delete</button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
            
        </div>
    </div>
</body>
