<% layout('layouts/boilerplate') -%>

    <div class="row justify-content-center">
        
        <div class="col-7">
            <h1 class="mb-5">Login to your account on Wanderlust</h1>
            <form action="/login" method="POST" class="needs-validation" novalidate>
                <div class="mb-3">
                    <label for="username" class="form-label">Username</label>
                    <input 
                        id="username"
                        name="username" 
                        type="text"
                        class="form-control"
                        required
                    />
                    <div class="valid-feedback">Looks good</div>  
                    <div class="invalid-feedback">Enter your username </div>  
                </div>
                <div class="mb-3">
                    <label for="password" class="form-label">password</label>
                    <input 
                        id="password"
                        name="password" 
                        type="password"
                        class="form-control"
                        required
                    />
                    <div class="valid-feedback">Looks good</div>  
                    <div class="invalid-feedback">Enter a strong password</div>  
                </div>
                <button class="btn btn-danger">Login to my account</button>
            </form>
        </div>
    </div>