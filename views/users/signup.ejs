<% layout('layouts/boilerplate') -%>

<div class="auth-shell">
    <div class="auth-intro">
        <p class="eyebrow">JOIN WANDERLUST</p>
        <h1>Make room for more somewhere.</h1>
        <p>Create an account to share beautiful stays and plan the ones still waiting for you.</p>
    </div>
    <div class="auth-form-panel">
        <h2>Create your account</h2>

        <form action="/signup" method="POST" class="needs-validation" novalidate>
            <div class="mb-3">
                <label for="username" class="form-label">Username</label>
                <input id="username" name="username" type="text" class="form-control" required />
                <div class="valid-feedback">Looks good</div>
                <div class="invalid-feedback">Enter your username</div>
            </div>

            <div class="mb-3">
                <label for="email" class="form-label">Email</label>
                <input id="email" name="email" type="email" class="form-control" required />
                <div class="valid-feedback">Looks good</div>
                <div class="invalid-feedback">Enter your email</div>
            </div>

            <div class="mb-3">
                <label for="password" class="form-label">Password</label>
                <input id="password" name="password" type="password" class="form-control" required />
                <div class="valid-feedback">Looks good</div>
                <div class="invalid-feedback">Enter a strong password</div>
            </div>

            <button class="btn btn-dark w-100">Create my account</button>
        </form>
    </div>
</div>